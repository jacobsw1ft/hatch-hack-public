# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored and must NEVER be committed.
# For deployment, set these same variables in your Vercel project settings.

HATCH_EMAIL=you@example.com      # your Hatch account email
HATCH_PASSWORD=your-hatch-password
HATCH_PIN=1234                   # 4-digit PIN that protects the web page

# Optional: lock CORS to your site's origin (defaults to * if unset)
# FRONTEND_ORIGIN=https://yourdomain.com
